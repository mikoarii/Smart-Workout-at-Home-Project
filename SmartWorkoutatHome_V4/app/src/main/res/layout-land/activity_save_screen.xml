<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#80000000"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORKOUT COMPLETE!"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your session has been saved"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Stats Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:background="#80000000"
            android:elevation="6dp"
            android:padding="20dp">

            <!-- Left Column - Workout Type -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKOUT TYPE"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvWorkoutType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SQUAT"
                    android:textSize="20sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Middle Column - Total Reps -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL REPS"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvTotalReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="10"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Right Column - Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2:59"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <!-- Congratulations Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:padding="18dp"
            android:background="#804CAF50"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 Great Job!"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your progress has been recorded"
                android:textSize="14sp"
                android:textColor="#E8F5E9"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAlignment="center"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Single Button - SAVE & BACK TO HOME -->
        <Button
            android:id="@+id/btnSave_backtohome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE &amp; BACK TO HOME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:paddingVertical="16dp"
            android:letterSpacing="0.02"
            android:elevation="6dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            tools:ignore="HardcodedText" />

        <!-- Recent Activity Preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Activity:"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <!-- Recent Item Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#40000000"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="32dp"
            android:padding="14dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Squat - 10 reps"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2:59"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>