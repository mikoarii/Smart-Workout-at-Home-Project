<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg8"
    tools:context=".home_screen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- JUDUL APLIKASI -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="SMART WORKOUT"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.499"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- TOMBOL PUSH-UP -->
        <Button
            android:id="@+id/pushup"
            android:layout_width="250dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/green"
            android:text="PUSH-UP"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/squat"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

        <!-- TOMBOL SQUAT -->
        <Button
            android:id="@+id/squat"
            android:layout_width="250dp"
            android:layout_height="200dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/Bluessea"
            android:text="SQUAT"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/pushup"
            app:layout_constraintTop_toTopOf="@id/pushup" />

        <!-- TOMBOL RIWAYAT -->
        <Button
            android:id="@+id/riwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/Blue"
            android:text="RIWAYAT"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pushup" />

        <!-- CARD STATUS KONEKSI (SEDERHANA) -->
        <androidx.cardview.widget.CardView
            android:layout_width="550dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#212332"
            app:cardCornerRadius="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/riwayat">

            <LinearLayout
                android:id="@+id/layout_koneksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="DATA SELULER"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/tvDataStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENUNGGU"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        android:textSize="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="HOTSPOT HP"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/tvHotspotStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENUNGGU"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        android:textSize="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="ALAT ESP32"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/tvEspStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENUNGGU"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        android:textSize="14dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3A3D52"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Petunjuk: Aktifkan Data HP, Nyalakan Hotspot (SSID: SmartWorkout | Pass: 12345678), lalu nyalakan saklar daya ESP32."
                    android:textColor="#AAAAAA"
                    android:textSize="11dp"
                    android:gravity="center" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>